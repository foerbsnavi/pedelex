{
  "name": "pedelex",
  "version": "0.1.0",
  "description": "Open machine-readable database of e-bike drive system error codes",
  "type": "module",
  "private": true,
  "scripts": {
    "validate": "node tools/validate.mjs",
    "duplicates": "node tools/check_duplicates.mjs",
    "relations": "node tools/check_relations.mjs",
    "build": "node tools/build.mjs",
    "check": "npm run validate && npm run duplicates && npm run relations"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.0"
  },
  "license": "SEE LICENSE-CODE AND LICENSE-DATA",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foerbsnavi/pedelex.git"
  },
  "homepage": "https://github.com/foerbsnavi/pedelex#readme",
  "bugs": {
    "url": "https://github.com/foerbsnavi/pedelex/issues"
  },
  "keywords": [
    "ebike",
    "e-bike",
    "pedelec",
    "error-codes",
    "bosch-ebike",
    "shimano-steps",
    "yamaha",
    "diagnostics",
    "open-data",
    "cc0",
    "yaml",
    "json-schema"
  ]
}
